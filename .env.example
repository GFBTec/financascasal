# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings → API / Data API).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# "Publishable key" (sb_publishable_...) ou a "anon key" legada. É pública por design;
# a segurança vem das políticas de RLS no banco.
VITE_SUPABASE_PUBLISHABLE_KEY=
